diff --git a/gm8exe/src/gm7.rs b/gm8exe/src/gm7.rs
new file mode 100644
index 0000000..6a9ba18
--- /dev/null
+++ b/gm8exe/src/gm7.rs
@@ -0,0 +1,551 @@
+//! GameMaker 7.0 executable support.
+//!
+//! GM7 executables keep the gamedata at a fixed offset (1980000) and differ from GM8.0 in a few ways:
+//!  - the settings block is stored uncompressed (version 702),
+//!  - after the embedded D3DX8 DLL comes a single zlib stream holding *all* assets, obfuscated with the
+//!    seed-based swap table also used by .gmk files ("GMKrypt"),
+//!  - assets are stored inline (not individually compressed) with older version numbers,
+//!  - sprite frames are BGR with no alpha (colour-key transparency) and carry no collision masks,
+//!  - objects have 11 event lists instead of 12 (no trigger events).
+//!
+//! The result is presented as a GameMaker 8.0 game, whose runtime is close to a superset of GM7's.
+
+use crate::{
+    asset::{
+        font::Font,
+        object::Object,
+        sprite::{CollisionMap, Frame},
+        Asset, Background, CodeAction, Constant, Error, PascalString, Path, ReadChunk, ReadPascalString, Room, Script,
+        Sound,
+        Sprite, Timeline,
+    },
+    reader::ReaderError,
+    settings::{GameHelpDialog, Settings},
+    AssetList, GameAssets, GameVersion,
+};
+use byteorder::{ReadBytesExt, LE};
+use flate2::read::ZlibDecoder;
+use std::io::{self, Read, Seek, SeekFrom};
+
+const HEADER_OFFSET: u64 = 1980000;
+const MAGIC: u32 = 1234321;
+
+type Cursor<'a> = io::Cursor<&'a [u8]>;
+
+/// Returns true if this looks like a GameMaker 7.0 executable.
+pub fn check(exe: &[u8]) -> bool {
+    let pos = HEADER_OFFSET as usize;
+    match (exe.get(pos..pos + 4), exe.get(pos + 4..pos + 8)) {
+        (Some(magic), Some(ver)) => {
+            u32::from_le_bytes(magic.try_into().unwrap()) == MAGIC && u32::from_le_bytes(ver.try_into().unwrap()) == 700
+        },
+        _ => false,
+    }
+}
+
+fn read_bool(r: &mut impl Read) -> io::Result<bool> {
+    Ok(r.read_u32::<LE>()? != 0)
+}
+
+fn expect_ver(what: &'static str, expected: u32, got: u32, strict: bool) -> Result<(), ReaderError> {
+    if strict && got != expected {
+        let _ = what;
+        return Err(ReaderError::AssetError(Error::VersionError { expected, got }))
+    }
+    Ok(())
+}
+
+fn inflate_all(data: &[u8]) -> io::Result<Vec<u8>> {
+    let mut out = Vec::new();
+    ZlibDecoder::new(data).read_to_end(&mut out)?;
+    Ok(out)
+}
+
+/// Reads an optional zlib blob as stored in GM7 settings: `exists, len, data`.
+fn skip_blob_maybe(r: &mut Cursor) -> io::Result<()> {
+    if read_bool(r)? {
+        let len = r.read_u32::<LE>()?;
+        r.seek(SeekFrom::Current(len.into()))?;
+    }
+    Ok(())
+}
+
+/// Builds the inverse of GM7's seeded byte-substitution table.
+fn reverse_swap_table(seed: u32) -> [u8; 256] {
+    let a = 6 + (seed % 250);
+    let b = seed / 250;
+    let mut table = [0u8; 256];
+    for (i, x) in table.iter_mut().enumerate() {
+        *x = i as u8;
+    }
+    for i in 1..=10000u32 {
+        let j = (1 + ((i * a + b) % 254)) as usize;
+        table.swap(j, j + 1);
+    }
+    let mut reverse = [0u8; 256];
+    for i in 1..256 {
+        reverse[table[i] as usize] = i as u8;
+    }
+    reverse
+}
+
+/// Script sources are stored as zlib streams, substitution-encrypted with the fixed seed 12345,
+/// holding a length-prefixed string.
+fn decode_script(data: &[u8]) -> Result<PascalString, ReaderError> {
+    let reverse = reverse_swap_table(12345);
+    let plain = inflate_all(data)?.into_iter().map(|b| reverse[b as usize]).collect::<Vec<_>>();
+    Ok(io::Cursor::new(plain.as_slice()).read_pas_string()?)
+}
+
+/// Removes the GMKrypt obfuscation: `bill, fred, junk[bill], seed, junk[fred], 1 plain byte, data...`
+fn deobfuscate(data: &[u8]) -> Result<Vec<u8>, ReaderError> {
+    let mut r = io::Cursor::new(data);
+    let bill = r.read_u32::<LE>()? as u64;
+    let fred = r.read_u32::<LE>()? as u64;
+    r.seek(SeekFrom::Current((bill * 4) as i64))?;
+    let seed = r.read_u32::<LE>()?;
+    r.seek(SeekFrom::Current((fred * 4) as i64))?;
+    let start = r.position() as usize;
+    if start >= data.len() {
+        return Err(ReaderError::UnknownFormat)
+    }
+
+    let reverse = reverse_swap_table(seed);
+    let mut out = Vec::with_capacity(data.len() - start);
+    out.push(data[start]);
+    for (pos, &byte) in data.iter().enumerate().skip(start + 1) {
+        out.push(reverse[byte as usize].wrapping_sub(pos as u8));
+    }
+    Ok(out)
+}
+
+/// Reads a GM7 image block (`540, exists, width, height, len, zlib BGR0 data`) as BGRA.
+/// GM7 stores no alpha, so if `transparent` is set the bottom-left pixel's colour becomes fully transparent.
+fn read_image(r: &mut Cursor, transparent: bool, strict: bool) -> Result<Option<(u32, u32, Box<[u8]>)>, ReaderError> {
+    expect_ver("image", 540, r.read_u32::<LE>()?, strict)?;
+    if r.read_i32::<LE>()? == -1 {
+        return Ok(None)
+    }
+    let width = r.read_u32::<LE>()?;
+    let height = r.read_u32::<LE>()?;
+    let len = r.read_u32::<LE>()? as usize;
+    let mut data = inflate_all(&r.read_chunk(len)?)?;
+    if data.len() != width as usize * height as usize * 4 {
+        return Err(ReaderError::AssetError(Error::MalformedData))
+    }
+    let key = if transparent && width > 0 && height > 0 {
+        let i = (height as usize - 1) * width as usize * 4;
+        let bottom_left = [data[i], data[i + 1], data[i + 2]];
+        if std::env::var_os("OPENGMK_GM7_CLAVE_ESQUINA").is_some() {
+            Some(bottom_left) // old behaviour, to replay runs made before the fix
+        } else {
+            Some(padding_row_key(&data, width as usize, height as usize).unwrap_or(bottom_left))
+        }
+    } else {
+        None
+    };
+    for px in data.chunks_exact_mut(4) {
+        px[3] = if key.map_or(false, |k| px[..3] == k) { 0 } else { 255 };
+    }
+    Ok(Some((width, height, data.into_boxed_slice())))
+}
+
+/// Some sprites (e.g. sprSpikeUp, 32x33) have an extra bottom row meant
+/// to hold the transparent colour, but in the exe that row is dark, so the bottom-left pixel keys out the outline
+/// instead of the background. The stored alpha byte, though, is 0 over the whole extra row and over the real
+/// background. When the bottom row is entirely alpha 0, use the most common colour among alpha-0 pixels.
+fn padding_row_key(data: &[u8], width: usize, height: usize) -> Option<[u8; 3]> {
+    let row = &data[(height - 1) * width * 4..height * width * 4];
+    if !row.chunks_exact(4).all(|px| px[3] == 0) {
+        return None
+    }
+    let mut counts = std::collections::HashMap::new();
+    for px in data.chunks_exact(4).filter(|px| px[3] == 0) {
+        *counts.entry([px[0], px[1], px[2]]).or_insert(0usize) += 1;
+    }
+    counts.into_iter().max_by_key(|&(colour, n)| (n, colour)).map(|(colour, _)| colour)
+}
+
+fn read_settings(r: &mut Cursor) -> Result<Settings, ReaderError> {
+    let fullscreen = read_bool(r)?;
+    let interpolate_pixels = read_bool(r)?;
+    let dont_draw_border = read_bool(r)?;
+    let display_cursor = read_bool(r)?;
+    let scaling = r.read_i32::<LE>()?;
+    let allow_resize = read_bool(r)?;
+    let window_on_top = read_bool(r)?;
+    let clear_colour = r.read_u32::<LE>()?;
+    let set_resolution = read_bool(r)?;
+    let colour_depth = r.read_u32::<LE>()?;
+    let resolution = r.read_u32::<LE>()?;
+    let frequency = r.read_u32::<LE>()?;
+    let dont_show_buttons = read_bool(r)?;
+    let vsync = read_bool(r)?;
+    let f4_fullscreen_toggle = read_bool(r)?;
+    let f1_help_menu = read_bool(r)?;
+    let esc_close_game = read_bool(r)?;
+    let f5_save_f6_load = read_bool(r)?;
+    let f9_screenshot = read_bool(r)?;
+    let treat_close_as_esc = read_bool(r)?;
+    let priority = r.read_u32::<LE>()?;
+    let freeze_on_lose_focus = read_bool(r)?;
+    // Loading bar images are only cosmetic and GM7 stores them in a different encoding, so they're dropped.
+    if r.read_u32::<LE>()? != 0 {
+        skip_blob_maybe(r)?;
+        skip_blob_maybe(r)?;
+    }
+    skip_blob_maybe(r)?;
+    let transparent = read_bool(r)?;
+    let translucency = r.read_u32::<LE>()?;
+    let scale_progress_bar = read_bool(r)?;
+    let show_error_messages = read_bool(r)?;
+    let log_errors = read_bool(r)?;
+    let always_abort = read_bool(r)?;
+    let zero_uninitialized_vars = read_bool(r)?;
+    r.read_u32::<LE>()?; // unknown trailing field
+
+    Ok(Settings {
+        fullscreen,
+        scaling,
+        interpolate_pixels,
+        clear_colour,
+        allow_resize,
+        window_on_top,
+        dont_draw_border,
+        dont_show_buttons,
+        display_cursor,
+        freeze_on_lose_focus,
+        disable_screensaver: false,
+        force_cpu_render: true,
+        set_resolution,
+        colour_depth,
+        resolution,
+        frequency,
+        vsync,
+        esc_close_game,
+        treat_close_as_esc,
+        f1_help_menu,
+        f4_fullscreen_toggle,
+        f5_save_f6_load,
+        f9_screenshot,
+        priority,
+        custom_load_image: None,
+        transparent,
+        translucency,
+        loading_bar: 0,
+        backdata: None,
+        frontdata: None,
+        scale_progress_bar,
+        show_error_messages,
+        log_errors,
+        always_abort,
+        zero_uninitialized_vars,
+        error_on_uninitialized_args: false,
+        swap_creation_events: false,
+    })
+}
+
+/// Reads `version, count, [exists, asset]...` where each asset can be parsed by the GM8 exe deserializer.
+fn read_list<T: Asset>(r: &mut Cursor, header: u32, strict: bool) -> Result<AssetList<T>, ReaderError> {
+    expect_ver("asset header", header, r.read_u32::<LE>()?, strict)?;
+    let count = r.read_u32::<LE>()?;
+    (0..count)
+        .map(|_| {
+            if read_bool(r)? {
+                Ok(Some(Box::new(T::deserialize_exe(&mut *r, GameVersion::GameMaker8_0, false)?)))
+            } else {
+                Ok(None)
+            }
+        })
+        .collect()
+}
+
+fn read_list_with<T>(
+    r: &mut Cursor,
+    header: u32,
+    strict: bool,
+    mut f: impl FnMut(&mut Cursor) -> Result<T, ReaderError>,
+) -> Result<AssetList<T>, ReaderError> {
+    expect_ver("asset header", header, r.read_u32::<LE>()?, strict)?;
+    let count = r.read_u32::<LE>()?;
+    (0..count).map(|_| if read_bool(r)? { Ok(Some(Box::new(f(r)?))) } else { Ok(None) }).collect()
+}
+
+fn read_sprite(r: &mut Cursor, strict: bool) -> Result<Sprite, ReaderError> {
+    let name = r.read_pas_string()?;
+    expect_ver("sprite", 542, r.read_u32::<LE>()?, strict)?;
+    let width = r.read_u32::<LE>()?;
+    let height = r.read_u32::<LE>()?;
+    let bbox_left = r.read_i32::<LE>()?;
+    let bbox_right = r.read_i32::<LE>()?;
+    let bbox_bottom = r.read_i32::<LE>()?;
+    let bbox_top = r.read_i32::<LE>()?;
+    let transparent = read_bool(r)?;
+    let _smooth_edges = read_bool(r)?;
+    let _preload = read_bool(r)?;
+    let _bbox_mode = r.read_u32::<LE>()?;
+    let precise = read_bool(r)?;
+    let origin_x = r.read_i32::<LE>()?;
+    let origin_y = r.read_i32::<LE>()?;
+    let frame_count = r.read_u32::<LE>()?;
+
+    let frames = (0..frame_count)
+        .map(|_| {
+            Ok(match read_image(r, transparent, strict)? {
+                Some((width, height, data)) => Frame { width, height, data },
+                None => Frame { width, height, data: vec![0u8; width as usize * height as usize * 4].into() },
+            })
+        })
+        .collect::<Result<Vec<_>, ReaderError>>()?;
+
+    // GM7 builds collision masks at load time: the bounding box intersected with the opaque pixels
+    // of each frame when precise, otherwise the plain bounding box shared by all frames.
+    let clamp = |v: i32, max: u32| v.clamp(0, max.saturating_sub(1) as i32) as u32;
+    let (left, right) = (clamp(bbox_left, width), clamp(bbox_right, width));
+    let (top, bottom) = (clamp(bbox_top, height), clamp(bbox_bottom, height));
+    let in_bbox = |x: u32, y: u32| x >= left && x <= right && y >= top && y <= bottom;
+    let make_map = |frame: Option<&Frame>| {
+        let data = (0..height)
+            .flat_map(|y| (0..width).map(move |x| (x, y)))
+            .map(|(x, y)| {
+                in_bbox(x, y)
+                    && frame.map_or(true, |f| {
+                        f.width != width || f.data[(y * width + x) as usize * 4 + 3] != 0
+                    })
+            })
+            .collect::<Vec<_>>()
+            .into_boxed_slice();
+        CollisionMap { width, height, bbox_left: left, bbox_right: right, bbox_top: top, bbox_bottom: bottom, data }
+    };
+    let (colliders, per_frame_colliders) = if frames.is_empty() {
+        (Vec::new(), false)
+    } else if precise {
+        (frames.iter().map(|f| make_map(Some(f))).collect(), true)
+    } else {
+        (vec![make_map(None)], false)
+    };
+
+    Ok(Sprite { name, origin_x, origin_y, frames, colliders, per_frame_colliders })
+}
+
+fn read_background(r: &mut Cursor, strict: bool) -> Result<Background, ReaderError> {
+    let name = r.read_pas_string()?;
+    expect_ver("background", 543, r.read_u32::<LE>()?, strict)?;
+    let mut width = r.read_u32::<LE>()?;
+    let mut height = r.read_u32::<LE>()?;
+    let transparent = read_bool(r)?;
+    let _smooth_edges = read_bool(r)?;
+    let _preload = read_bool(r)?;
+    let data = if read_bool(r)? {
+        read_image(r, transparent, strict)?.map(|(w, h, data)| {
+            width = w;
+            height = h;
+            data
+        })
+    } else {
+        None
+    };
+    Ok(Background { name, width, height, data })
+}
+
+fn read_font(r: &mut Cursor, strict: bool) -> Result<Font, ReaderError> {
+    let name = r.read_pas_string()?;
+    expect_ver("font", 540, r.read_u32::<LE>()?, strict)?;
+    let sys_name = r.read_pas_string()?;
+    let size = r.read_u32::<LE>()?;
+    let bold = read_bool(r)?;
+    let italic = read_bool(r)?;
+    let range_start = r.read_u32::<LE>()?;
+    let range_end = r.read_u32::<LE>()?;
+    let mut dmap = [0u32; 0x600];
+    for val in dmap.iter_mut() {
+        *val = r.read_u32::<LE>()?;
+    }
+    let map_width = r.read_u32::<LE>()?;
+    let map_height = r.read_u32::<LE>()?;
+    let len = r.read_u32::<LE>()? as usize;
+    let pixel_map = inflate_all(&r.read_chunk(len)?)?.into_boxed_slice();
+    Ok(Font {
+        name,
+        sys_name,
+        size,
+        bold,
+        italic,
+        range_start,
+        range_end,
+        charset: 0,
+        aa_level: 0,
+        dmap: Box::new(dmap),
+        map_width,
+        map_height,
+        pixel_map,
+    })
+}
+
+fn read_object(r: &mut Cursor, strict: bool) -> Result<Object, ReaderError> {
+    let name = r.read_pas_string()?;
+    expect_ver("object", 430, r.read_u32::<LE>()?, strict)?;
+    let sprite_index = r.read_i32::<LE>()?;
+    let solid = read_bool(r)?;
+    let visible = read_bool(r)?;
+    let depth = r.read_i32::<LE>()?;
+    let persistent = read_bool(r)?;
+    let parent_index = r.read_i32::<LE>()?;
+    let mask_index = r.read_i32::<LE>()?;
+
+    // GM7 has 11 event types (0..=10); GM8 added triggers as the 12th, which we leave empty.
+    let event_list_count = r.read_u32::<LE>()?;
+    if event_list_count > 11 {
+        return Err(ReaderError::AssetError(Error::MalformedData))
+    }
+    let mut events = Vec::with_capacity(12);
+    for _ in 0..=event_list_count {
+        let mut sub_event_list = Vec::new();
+        while let Ok(index) = u32::try_from(r.read_i32::<LE>()?) {
+            expect_ver("event", 400, r.read_u32::<LE>()?, strict)?;
+            let action_count = r.read_u32::<LE>()?;
+            let actions = (0..action_count)
+                .map(|_| CodeAction::deserialize_exe(&mut *r, GameVersion::GameMaker8_0, false))
+                .collect::<Result<_, _>>()?;
+            sub_event_list.push((index, actions));
+        }
+        events.push(sub_event_list);
+    }
+    while events.len() < 12 {
+        events.push(Vec::new());
+    }
+
+    Ok(Object { name, sprite_index, solid, visible, depth, persistent, parent_index, mask_index, events })
+}
+
+/// Parses a GameMaker 7.0 executable. Call `check` first.
+pub fn from_exe<F>(
+    exe: &[u8],
+    ico_file_raw: Option<Vec<u8>>,
+    logger: Option<F>,
+    strict: bool,
+) -> Result<GameAssets, ReaderError>
+where
+    F: Copy + Fn(&str),
+{
+    let mut r = io::Cursor::new(exe);
+    r.set_position(HEADER_OFFSET + 8);
+    let _debug = read_bool(&mut r)?;
+    expect_ver("settings", 702, r.read_u32::<LE>()?, strict)?;
+    let settings = read_settings(&mut r)?;
+    log!(logger, "Read GM7 settings, now at 0x{:X}", r.position());
+
+    let dll_name = r.read_pas_string()?;
+    let dll_len = r.read_u32::<LE>()? as usize;
+    let dx_dll = r.read_chunk(dll_len)?;
+    log!(logger, "Skipped embedded DLL '{}' ({} bytes)", dll_name, dll_len);
+
+    let data_len = r.read_u32::<LE>()? as usize;
+    let compressed = r.read_chunk(data_len)?;
+    let data = deobfuscate(&inflate_all(&compressed)?)?;
+    log!(logger, "Inflated and decrypted GM7 asset data ({} bytes)", data.len());
+
+    let mut r = io::Cursor::new(data.as_slice());
+    let _unknown = r.read_u32::<LE>()?;
+    let game_id = r.read_u32::<LE>()?;
+    let guid = [r.read_u32::<LE>()?, r.read_u32::<LE>()?, r.read_u32::<LE>()?, r.read_u32::<LE>()?];
+    log!(logger, "Game ID: {}", game_id);
+
+    expect_ver("extensions header", 700, r.read_u32::<LE>()?, strict)?;
+    if r.read_u32::<LE>()? != 0 {
+        log!(logger, "GM7 extension packages are not supported");
+        return Err(ReaderError::UnknownFormat)
+    }
+
+    // Sound data is individually zlib-compressed in GM7 and scripts have their own encoding; the rest is raw.
+    let mut sounds: AssetList<Sound> = read_list(&mut r, 400, strict)?;
+    for sound in sounds.iter_mut().flatten() {
+        if let Some(data) = &mut sound.data {
+            *data = inflate_all(data)?.into_boxed_slice();
+        }
+    }
+    log!(logger, " + {} sounds", sounds.len());
+    let sprites = read_list_with(&mut r, 400, strict, |r| read_sprite(r, strict))?;
+    log!(logger, " + {} sprites", sprites.len());
+    let backgrounds = read_list_with(&mut r, 400, strict, |r| read_background(r, strict))?;
+    log!(logger, " + {} backgrounds", backgrounds.len());
+    let paths: AssetList<Path> = read_list(&mut r, 420, strict)?;
+    log!(logger, " + {} paths", paths.len());
+    let mut scripts: AssetList<Script> = read_list(&mut r, 400, strict)?;
+    for script in scripts.iter_mut().flatten() {
+        if !script.source.0.is_empty() {
+            script.source = decode_script(&script.source.0)?;
+        }
+    }
+    log!(logger, " + {} scripts", scripts.len());
+    let fonts = read_list_with(&mut r, 540, strict, |r| read_font(r, strict))?;
+    log!(logger, " + {} fonts", fonts.len());
+    let timelines: AssetList<Timeline> = read_list(&mut r, 500, strict)?;
+    log!(logger, " + {} timelines", timelines.len());
+    let objects = read_list_with(&mut r, 400, strict, |r| read_object(r, strict))?;
+    log!(logger, " + {} objects", objects.len());
+    let rooms: AssetList<Room> = read_list(&mut r, 420, strict)?;
+    log!(logger, " + {} rooms", rooms.len());
+
+    let last_instance_id = r.read_i32::<LE>()?;
+    let last_tile_id = r.read_i32::<LE>()?;
+
+    expect_ver("included files header", 620, r.read_u32::<LE>()?, strict)?;
+    if r.read_u32::<LE>()? != 0 {
+        log!(logger, "GM7 included files are not supported");
+        return Err(ReaderError::UnknownFormat)
+    }
+
+    expect_ver("help dialog", 600, r.read_u32::<LE>()?, strict)?;
+    let help_dialog = GameHelpDialog {
+        bg_colour: r.read_u32::<LE>()?.into(),
+        new_window: read_bool(&mut r)?,
+        caption: r.read_pas_string()?,
+        left: r.read_i32::<LE>()?,
+        top: r.read_i32::<LE>()?,
+        width: r.read_u32::<LE>()?,
+        height: r.read_u32::<LE>()?,
+        border: read_bool(&mut r)?,
+        resizable: read_bool(&mut r)?,
+        window_on_top: read_bool(&mut r)?,
+        freeze_game: read_bool(&mut r)?,
+        info: r.read_pas_string()?,
+    };
+
+    expect_ver("action library initialization code header", 500, r.read_u32::<LE>()?, strict)?;
+    let str_count = r.read_u32::<LE>()?;
+    let library_init_strings = (0..str_count).map(|_| r.read_pas_string()).collect::<io::Result<_>>()?;
+
+    expect_ver("room order lookup", 700, r.read_u32::<LE>()?, strict)?;
+    let ro_count = r.read_u32::<LE>()?;
+    let room_order = (0..ro_count).map(|_| r.read_i32::<LE>()).collect::<io::Result<_>>()?;
+
+    Ok(GameAssets {
+        extensions: Vec::new(),
+        sprites,
+        sounds,
+        backgrounds,
+        paths,
+        scripts,
+        fonts,
+        timelines,
+        objects,
+        triggers: Vec::new(),
+        constants: Vec::<Constant>::new(),
+        rooms,
+        included_files: Vec::new(),
+
+        dx_dll,
+        ico_file_raw,
+        version: GameVersion::GameMaker8_0,
+        help_dialog,
+        last_instance_id,
+        last_tile_id,
+        library_init_strings,
+        room_order,
+
+        settings,
+        game_id,
+        guid,
+    })
+}
