+++ b/gm8emulator/src/game/rl.rs
@@ -0,0 +1,381 @@
+//! Frame-by-frame control of the game by an external reinforcement learning client.
+//!
+//! The emulator listens on a Unix socket and serves one client. Every request starts with a one-byte
+//! opcode; all integers are little-endian. stdout is left alone since the emulator logs there.
+//!
+//! | op | request                                        | response                                                   |
+//! |----|------------------------------------------------|------------------------------------------------------------|
+//! | 1  | STEP: u8 n, n x u8 vk held, u32 frames, u8 fl  | u8 status, i32 room, u64 frame, [obs]                      |
+//! | 2  | SAVE: u32 slot                                 | u8 status                                                  |
+//! | 3  | LOAD: u32 slot                                 | u8 status                                                  |
+//! | 4  | OBS                                            | obs                                                        |
+//! | 5  | QUERY: u16 len, object name                    | u32 n, n x (i32 id, f64 x, f64 y, f64 hspeed, f64 vspeed)  |
+//! | 6  | INFO                                           | i32 room, u32 w, u32 h, u32 speed, u16 len, name, u64 frame |
+//! | 7  | EXEC: u32 len, GML code                        | u8 status, [u16 len, error] or value                      |
+//! | 8  | TRACK: u16 len, object name                    | u8 status (0 = ok, 2 = no such object)                     |
+//! | 255| QUIT                                           | (none)                                                     |
+//!
+//! `obs` is `u32 width, u32 height, width*height*3 bytes RGB, top row first`.
+//! STEP status: 0 = ok, 1 = the game ended (it is restarted), 2 = runtime error followed by `u16 len, message`.
+//! STEP flags: bit 0 = send obs, bit 1 = skip drawing all but the last frame (faster, but draw events don't run),
+//! bit 2 = send a trace of the tracked object, bit 3 = don't draw any frame (not even the last one),
+//! bit 4 = stop early when the tracked object has no instance left (e.g. the player died).
+//! The trace follows the obs: `u32 n` and one record per frame run, `i32 room, u8 alive, f32 x, f32 y,
+//! i32 sprite_index, f32 image_index, f32 image_xscale` (the first active instance of the tracked object).
+//! Holding keys is level-triggered: keys absent from a STEP are released before it runs.
+//! EXEC runs the code like room creation code (as a dummy instance, `global.` and `with` work) and applies any
+//! room change it requests right away. `value` is `u8 0, f64` for reals or `u8 1, u16 len, bytes` for strings.
+
+use crate::{
+    game::{replay::Replay, savestate::SaveState, Game, GameClock, GetAsset, SceneChange},
+    gml::{Context, Value},
+    instance::{Instance, InstanceState},
+};
+use byteorder::{ReadBytesExt, WriteBytesExt, LE};
+use std::{
+    collections::{BTreeSet, HashMap},
+    io::{self, BufReader, BufWriter, Read, Write},
+    os::unix::net::UnixListener,
+    path::Path,
+    time::Duration,
+};
+
+const OP_STEP: u8 = 1;
+const OP_SAVE: u8 = 2;
+const OP_LOAD: u8 = 3;
+const OP_OBS: u8 = 4;
+const OP_QUERY: u8 = 5;
+const OP_INFO: u8 = 6;
+const OP_EXEC: u8 = 7;
+const OP_TRACK: u8 = 8;
+const OP_QUIT: u8 = 255;
+
+const STATUS_OK: u8 = 0;
+const STATUS_ENDED: u8 = 1;
+const STATUS_ERROR: u8 = 2;
+
+fn write_str(w: &mut impl Write, s: &[u8]) -> io::Result<()> {
+    let s = &s[..s.len().min(u16::MAX as usize)];
+    w.write_u16::<LE>(s.len() as u16)?;
+    w.write_all(s)
+}
+
+impl Game {
+    /// Runs one frame and any scene change it requested. Returns false if the game ended and was restarted.
+    fn rl_frame(&mut self) -> Result<bool, Box<dyn std::error::Error>> {
+        self.input.mouse_step();
+        self.frame()?;
+        let running = self.rl_apply_scene_change()?;
+
+        if let GameClock::SpoofedNanos(t) = &mut self.clock {
+            *t += Duration::from_nanos(1_000_000_000 / u64::from(self.room.speed.max(1))).as_nanos();
+        }
+        self.fps = self.room.speed;
+        Ok(running)
+    }
+
+    /// Performs a pending room change/restart/load. Returns false if the game ended and was restarted.
+    fn rl_apply_scene_change(&mut self) -> Result<bool, Box<dyn std::error::Error>> {
+        let mut running = true;
+        match self.scene_change {
+            Some(SceneChange::Room(id)) => self.load_room(id)?,
+            Some(SceneChange::Restart) => self.restart()?,
+            Some(SceneChange::End) => {
+                self.restart()?;
+                running = false;
+            },
+            Some(SceneChange::Load(ref mut path)) => {
+                let path = std::mem::take(path);
+                self.load_gm_save(path)?
+            },
+            None => (),
+        }
+        if self.close_requested {
+            self.close_requested = false;
+            self.restart()?;
+            running = false;
+        }
+        Ok(running)
+    }
+
+    fn rl_exec(&mut self, code: &[u8]) -> Result<Value, Box<dyn std::error::Error>> {
+        let instructions = self.compiler.compile(code)?;
+        let dummy = self
+            .room
+            .instance_list
+            .insert_dummy(Instance::new_dummy(self.assets.objects.get_asset(0).map(|x| x.as_ref())));
+        let mut context = Context::with_single_instance(dummy);
+        let result = self.execute(&instructions, &mut context);
+        self.room.instance_list.remove_dummy(dummy);
+        result?;
+        self.rl_apply_scene_change()?;
+        Ok(context.return_value)
+    }
+
+    fn rl_write_obs(&self, w: &mut impl Write) -> io::Result<()> {
+        let (width, height) = self.window_inner_size;
+        let rgba = self.renderer.get_pixels(0, 0, width as i32, height as i32);
+        w.write_u32::<LE>(width)?;
+        w.write_u32::<LE>(height)?;
+        // OpenGMK's framebuffer is already stored top row first
+        let mut row = vec![0u8; width as usize * 3];
+        for y in 0..height as usize {
+            let src = &rgba[y * width as usize * 4..(y + 1) * width as usize * 4];
+            for (dst, px) in row.chunks_exact_mut(3).zip(src.chunks_exact(4)) {
+                dst.copy_from_slice(&px[..3]);
+            }
+            w.write_all(&row)?;
+        }
+        Ok(())
+    }
+
+    /// Trace record of the first active instance of an object: (alive, x, y, sprite, image_index, xscale).
+    fn rl_trace_record(&self, object_index: Option<i32>) -> (bool, f32, f32, i32, f32, f32) {
+        if let Some(object_index) = object_index {
+            let mut iter = self.room.instance_list.iter_by_identity(object_index);
+            while let Some(handle) = iter.next(&self.room.instance_list) {
+                let inst = self.room.instance_list.get(handle);
+                if inst.state.get() == InstanceState::Active {
+                    return (
+                        true,
+                        f64::from(inst.x.get()) as f32,
+                        f64::from(inst.y.get()) as f32,
+                        inst.sprite_index.get(),
+                        f64::from(inst.image_index.get()) as f32,
+                        f64::from(inst.image_xscale.get()) as f32,
+                    )
+                }
+            }
+        }
+        (false, 0.0, 0.0, -1, 0.0, 0.0)
+    }
+
+    fn rl_object_index(&self, name: &[u8]) -> Option<i32> {
+        self.assets.objects.iter().position(|o| o.as_ref().map_or(false, |o| o.name.as_ref() == name)).map(|i| i as i32)
+    }
+
+    /// Serves an RL client on the given Unix socket until it sends QUIT or disconnects.
+    pub fn rl_server(mut self, socket_path: &Path, seed: i32) -> Result<(), Box<dyn std::error::Error>> {
+        // The renderer reserves two texture slots for the TAS UI's sprites (see `stock_atlas_count`);
+        // savestates break unless they exist, so fill them like replay mode does.
+        for _ in 0..2 {
+            self.renderer.upload_sprite(Box::new([0, 0, 0, 0]), 1, 1, 0, 0)?;
+        }
+        self.frame_limiter = false;
+        self.rand.set_seed(seed);
+        self.clock = GameClock::SpoofedNanos(0);
+        self.init()?;
+        match self.scene_change {
+            Some(SceneChange::Room(id)) => self.load_room(id)?,
+            Some(SceneChange::Restart) => self.restart()?,
+            _ => (),
+        }
+
+        let _ = std::fs::remove_file(socket_path);
+        let listener = UnixListener::bind(socket_path)?;
+        println!("RL server listening on {}", socket_path.display());
+        let (stream, _) = listener.accept()?;
+        let mut reader = BufReader::new(stream.try_clone()?);
+        let mut writer = BufWriter::new(stream);
+
+        let mut held: BTreeSet<u8> = BTreeSet::new();
+        // Savestates restore the emulator's input state, so remember which keys the client held with each one
+        let mut saves: HashMap<u32, (SaveState, BTreeSet<u8>)> = HashMap::new();
+        let mut frame: u64 = 0;
+        let mut tracked: Option<i32> = None;
+        let mut trace: Vec<(i32, (bool, f32, f32, i32, f32, f32))> = Vec::new();
+
+        loop {
+            let op = match reader.read_u8() {
+                Ok(op) => op,
+                Err(e) if e.kind() == io::ErrorKind::UnexpectedEof => break,
+                Err(e) => return Err(e.into()),
+            };
+            match op {
+                OP_STEP => {
+                    let n = reader.read_u8()?;
+                    let mut keys = BTreeSet::new();
+                    for _ in 0..n {
+                        keys.insert(reader.read_u8()?);
+                    }
+                    let frames = reader.read_u32::<LE>()?;
+                    let flags = reader.read_u8()?;
+                    let want_obs = flags & 1 != 0;
+                    let skip_draw = flags & 2 != 0;
+                    let want_trace = flags & 4 != 0;
+                    let no_draw = flags & 8 != 0;
+                    let stop_on_gone = flags & 16 != 0;
+                    trace.clear();
+
+                    for &k in held.difference(&keys) {
+                        self.input.button_release(k, true);
+                    }
+                    for &k in keys.difference(&held) {
+                        self.input.button_press(k, true);
+                    }
+                    held = keys;
+
+                    let mut status = STATUS_OK;
+                    let mut error = None;
+                    let frames = frames.max(1);
+                    for i in 0..frames {
+                        let skip = (no_draw || (skip_draw && i + 1 < frames)) && self.auto_draw;
+                        if skip {
+                            self.auto_draw = false;
+                        }
+                        let result = self.rl_frame();
+                        if skip {
+                            self.auto_draw = true;
+                        }
+                        let gone = if want_trace || stop_on_gone {
+                            let record = self.rl_trace_record(tracked);
+                            if want_trace {
+                                trace.push((self.room.id, record));
+                            }
+                            stop_on_gone && !record.0
+                        } else {
+                            false
+                        };
+                        match result {
+                            Ok(true) if gone => {
+                                frame += 1;
+                                break
+                            },
+                            Ok(true) => frame += 1,
+                            Ok(false) => {
+                                frame += 1;
+                                status = STATUS_ENDED;
+                                break
+                            },
+                            Err(e) => {
+                                status = STATUS_ERROR;
+                                error = Some(e.to_string());
+                                break
+                            },
+                        }
+                    }
+                    writer.write_u8(status)?;
+                    if let Some(msg) = error {
+                        write_str(&mut writer, msg.as_bytes())?;
+                    }
+                    writer.write_i32::<LE>(self.room.id)?;
+                    writer.write_u64::<LE>(frame)?;
+                    if want_obs {
+                        self.rl_write_obs(&mut writer)?;
+                    }
+                    if want_trace {
+                        writer.write_u32::<LE>(trace.len() as u32)?;
+                        for &(room, (alive, x, y, sprite, image_index, xscale)) in &trace {
+                            writer.write_i32::<LE>(room)?;
+                            writer.write_u8(alive as u8)?;
+                            writer.write_f32::<LE>(x)?;
+                            writer.write_f32::<LE>(y)?;
+                            writer.write_i32::<LE>(sprite)?;
+                            writer.write_f32::<LE>(image_index)?;
+                            writer.write_f32::<LE>(xscale)?;
+                        }
+                    }
+                },
+                OP_TRACK => {
+                    let len = reader.read_u16::<LE>()? as usize;
+                    let mut name = vec![0u8; len];
+                    reader.read_exact(&mut name)?;
+                    tracked = self.rl_object_index(&name);
+                    writer.write_u8(if tracked.is_some() { STATUS_OK } else { STATUS_ERROR })?;
+                },
+                OP_SAVE => {
+                    let slot = reader.read_u32::<LE>()?;
+                    let state = SaveState::from(&self, Replay::new(0, 0), self.renderer.state(), false);
+                    saves.insert(slot, (state, held.clone()));
+                    writer.write_u8(STATUS_OK)?;
+                },
+                OP_LOAD => {
+                    let slot = reader.read_u32::<LE>()?;
+                    match saves.get(&slot) {
+                        Some((state, saved_held)) => {
+                            let (_, renderer_state) = state.clone().load_into(&mut self);
+                            self.renderer.set_state(&renderer_state);
+                            held = saved_held.clone();
+                            writer.write_u8(STATUS_OK)?;
+                        },
+                        None => writer.write_u8(STATUS_ERROR)?,
+                    }
+                },
+                OP_OBS => self.rl_write_obs(&mut writer)?,
+                OP_QUERY => {
+                    let len = reader.read_u16::<LE>()? as usize;
+                    let mut name = vec![0u8; len];
+                    reader.read_exact(&mut name)?;
+                    let mut found = Vec::new();
+                    if let Some(object_index) = self.rl_object_index(&name) {
+                        let mut iter = self.room.instance_list.iter_by_identity(object_index);
+                        while let Some(handle) = iter.next(&self.room.instance_list) {
+                            let inst = self.room.instance_list.get(handle);
+                            if inst.state.get() == InstanceState::Active {
+                                found.push((
+                                    inst.id.get(),
+                                    f64::from(inst.x.get()),
+                                    f64::from(inst.y.get()),
+                                    f64::from(inst.hspeed.get()),
+                                    f64::from(inst.vspeed.get()),
+                                ));
+                            }
+                        }
+                    }
+                    writer.write_u32::<LE>(found.len() as u32)?;
+                    for (id, x, y, hspeed, vspeed) in found {
+                        writer.write_i32::<LE>(id)?;
+                        writer.write_f64::<LE>(x)?;
+                        writer.write_f64::<LE>(y)?;
+                        writer.write_f64::<LE>(hspeed)?;
+                        writer.write_f64::<LE>(vspeed)?;
+                    }
+                },
+                OP_INFO => {
+                    writer.write_i32::<LE>(self.room.id)?;
+                    writer.write_u32::<LE>(self.room.width.max(0) as u32)?;
+                    writer.write_u32::<LE>(self.room.height.max(0) as u32)?;
+                    writer.write_u32::<LE>(self.room.speed)?;
+                    let name = usize::try_from(self.room.id)
+                        .ok()
+                        .and_then(|i| self.assets.rooms.get(i))
+                        .and_then(|r| r.as_ref())
+                        .map(|r| r.name.as_ref().to_vec())
+                        .unwrap_or_default();
+                    write_str(&mut writer, &name)?;
+                    writer.write_u64::<LE>(frame)?;
+                },
+                OP_EXEC => {
+                    let len = reader.read_u32::<LE>()? as usize;
+                    let mut code = vec![0u8; len];
+                    reader.read_exact(&mut code)?;
+                    match self.rl_exec(&code) {
+                        Ok(value) => {
+                            writer.write_u8(STATUS_OK)?;
+                            match value {
+                                Value::Real(r) => {
+                                    writer.write_u8(0)?;
+                                    writer.write_f64::<LE>(r.into())?;
+                                },
+                                Value::Str(s) => {
+                                    writer.write_u8(1)?;
+                                    write_str(&mut writer, s.as_ref())?;
+                                },
+                            }
+                        },
+                        Err(e) => {
+                            writer.write_u8(STATUS_ERROR)?;
+                            write_str(&mut writer, e.to_string().as_bytes())?;
+                        },
+                    }
+                },
+                OP_QUIT => break,
+                other => return Err(format!("RL client sent unknown opcode {}", other).into()),
+            }
+            writer.flush()?;
+        }
+
+        let _ = std::fs::remove_file(socket_path);
+        Ok(())
+    }
+}
