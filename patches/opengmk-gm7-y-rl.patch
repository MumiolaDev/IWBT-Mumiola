+//! Reimplementación de GMFMODSimple.dll (FMOD Ex para GameMaker).
+//!
+//! El estado avanza con el reloj lógico del juego: cada paso consume exactamente `RATE / room_speed`
+//! muestras, así que lo que la lógica puede leer (si una instancia sigue sonando, su posición) es igual con
+//! audio o sin él, en cualquier máquina. La mezcla es opcional: si hay una salida conectada, cada paso deja
+//! su bloque de audio estéreo a 44,1 kHz en una cola que el backend de audio de la plataforma consume.
+//!
+//! Formatos: OGG Vorbis (decodificado en streaming por instancia) y WAV PCM/float (decodificado entero al
+//! cargar). Los efectos DSP de FMOD no se implementan: se aceptan y no hacen nada.
+//!
+//! Unidades de GMFMODSimple: volúmenes y pitch lineales (1 = normal), longitud en milisegundos, posiciones
+//! y puntos de loop como fracción de la duración (0 a 1).
+//!
+//! Savestates: `save_state` guarda los parámetros de sonidos e instancias, no el audio. Al cargar, los datos
+//! salen del caché de esta sesión o se vuelven a leer del archivo de origen.
+
+use serde::{Deserialize, Serialize};
+use std::{
+    collections::{BTreeMap, HashMap, VecDeque},
+    io::Cursor,
+    sync::{Arc, Mutex},
+};
+
+/// Frecuencia de la mezcla.
+pub const RATE: u32 = 44100;
+
+/// Máximo de audio pendiente en la cola de salida antes de descartar lo más viejo (en muestras estéreo).
+const MAX_QUEUED_FRAMES: usize = RATE as usize / 4;
+
+pub type OutputQueue = Arc<Mutex<VecDeque<f32>>>;
+
+enum Data {
+    Pcm { rate: u32, frames: Vec<[f32; 2]> },
+    Ogg { rate: u32, bytes: Arc<[u8]>, length: u64 },
+}
+
+impl Data {
+    fn rate(&self) -> u32 {
+        match self {
+            Data::Pcm { rate, .. } | Data::Ogg { rate, .. } => *rate,
+        }
+    }
+
+    fn length(&self) -> u64 {
+        match self {
+            Data::Pcm { frames, .. } => frames.len() as u64,
+            Data::Ogg { length, .. } => *length,
+        }
+    }
+}
+
+struct Sound {
+    /// Ruta de origen: identifica los datos en el caché y permite releerlos al cargar un savestate.
+    key: String,
+    data: Arc<Data>,
+    group: usize,
+    max_volume: f64,
+    loop_start: f64,
+    loop_end: f64,
+}
+
+struct Instance {
+    sound: usize,
+    data: Arc<Data>,
+    pos: f64,
+    pitch: f64,
+    volume: f64,
+    paused: bool,
+    looping: bool,
+    stream: Option<OggStream>,
+}
+
+#[derive(Clone, Copy, Serialize, Deserialize)]
+struct Group {
+    volume: f64,
+    pitch: f64,
+}
+
+pub struct Fmod {
+    sounds: Vec<Option<Sound>>,
+    instances: BTreeMap<u32, Instance>,
+    next_instance: u32,
+    groups: [Group; 5],
+    master_volume: f64,
+    output: Option<OutputQueue>,
+    sample_acc: f64,
+    mix: Vec<[f32; 2]>,
+    /// Audio ya decodificado por ruta. No forma parte del estado: solo evita releer archivos al cargar.
+    library: HashMap<String, Arc<Data>>,
+}
+
+#[derive(Clone, Serialize, Deserialize)]
+struct SoundState {
+    key: String,
+    group: usize,
+    max_volume: f64,
+    loop_start: f64,
+    loop_end: f64,
+}
+
+#[derive(Clone, Serialize, Deserialize)]
+struct InstanceState {
+    handle: u32,
+    sound: usize,
+    pos: f64,
+    pitch: f64,
+    volume: f64,
+    paused: bool,
+    looping: bool,
+}
+
+#[derive(Clone, Serialize, Deserialize)]
+pub struct FmodState {
+    sounds: Vec<Option<SoundState>>,
+    instances: Vec<InstanceState>,
+    next_instance: u32,
+    groups: [Group; 5],
+    master_volume: f64,
+    sample_acc: f64,
+}
+
+impl Default for Fmod {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl Fmod {
+    pub fn new() -> Self {
+        Self {
+            sounds: Vec::new(),
+            instances: BTreeMap::new(),
+            next_instance: 1,
+            groups: [Group { volume: 1.0, pitch: 1.0 }; 5],
+            master_volume: 1.0,
+            output: None,
+            sample_acc: 0.0,
+            mix: Vec::new(),
+            library: HashMap::new(),
+        }
+    }
+
+    pub fn save_state(&self) -> FmodState {
+        FmodState {
+            sounds: self
+                .sounds
+                .iter()
+                .map(|s| {
+                    s.as_ref().map(|s| SoundState {
+                        key: s.key.clone(),
+                        group: s.group,
+                        max_volume: s.max_volume,
+                        loop_start: s.loop_start,
+                        loop_end: s.loop_end,
+                    })
+                })
+                .collect(),
+            instances: self
+                .instances
+                .iter()
+                .map(|(&handle, i)| InstanceState {
+                    handle,
+                    sound: i.sound,
+                    pos: i.pos,
+                    pitch: i.pitch,
+                    volume: i.volume,
+                    paused: i.paused,
+                    looping: i.looping,
+                })
+                .collect(),
+            next_instance: self.next_instance,
+            groups: self.groups,
+            master_volume: self.master_volume,
+            sample_acc: self.sample_acc,
+        }
+    }
+
+    pub fn load_state(&mut self, state: FmodState) {
+        let mut sounds = Vec::with_capacity(state.sounds.len());
+        for s in state.sounds {
+            sounds.push(s.and_then(|s| {
+                let data = self.load_data(&s.key)?;
+                Some(Sound {
+                    key: s.key,
+                    data,
+                    group: s.group,
+                    max_volume: s.max_volume,
+                    loop_start: s.loop_start,
+                    loop_end: s.loop_end,
+                })
+            }));
+        }
+        let mut old = std::mem::take(&mut self.instances);
+        for i in state.instances {
+            let Some(sound) = sounds.get(i.sound).and_then(Option::as_ref) else { continue };
+            let data = sound.data.clone();
+            // El decodificador es solo un caché de posición: si la instancia sigue viva con los mismos datos,
+            // se reutiliza para no decodificar desde el principio.
+            let stream = match old.remove(&i.handle) {
+                Some(o) if Arc::ptr_eq(&o.data, &data) => o.stream,
+                _ => OggStream::new(&data),
+            };
+            self.instances.insert(i.handle, Instance {
+                sound: i.sound,
+                data,
+                pos: i.pos,
+                pitch: i.pitch,
+                volume: i.volume,
+                paused: i.paused,
+                looping: i.looping,
+                stream,
+            });
+        }
+        self.sounds = sounds;
+        self.next_instance = state.next_instance;
+        self.groups = state.groups;
+        self.master_volume = state.master_volume;
+        self.sample_acc = state.sample_acc;
+        if let Some(q) = &self.output {
+            if let Ok(mut q) = q.lock() {
+                q.clear();
+            }
+        }
+    }
+
+    fn load_data(&mut self, key: &str) -> Option<Arc<Data>> {
+        if let Some(d) = self.library.get(key) {
+            return Some(d.clone())
+        }
+        match std::fs::read(key).map_err(|e| e.to_string()).and_then(decode) {
+            Ok(d) => {
+                let d = Arc::new(d);
+                self.library.insert(key.to_string(), d.clone());
+                Some(d)
+            },
+            Err(e) => {
+                println!("WARNING (FMOD): al cargar el savestate no se pudo releer {}: {}", key, e);
+                None
+            },
+        }
+    }
+
+    /// Conecta la cola de la que lee el backend de audio. Sin salida, el estado avanza igual pero no se mezcla.
+    pub fn set_output(&mut self, output: Option<OutputQueue>) {
+        self.output = output;
+    }
+
+    fn sound(&self, id: f64) -> Option<&Sound> {
+        let i = (id as i64).checked_sub(1)?;
+        self.sounds.get(usize::try_from(i).ok()?)?.as_ref()
+    }
+
+    fn sound_mut(&mut self, id: f64) -> Option<&mut Sound> {
+        let i = (id as i64).checked_sub(1)?;
+        self.sounds.get_mut(usize::try_from(i).ok()?)?.as_mut()
+    }
+
+    fn instance_mut(&mut self, id: f64) -> Option<&mut Instance> {
+        self.instances.get_mut(&u32::try_from(id as i64).ok()?)
+    }
+
+    /// FMODSoundAdd: devuelve el id del sonido, o 0 si no se pudo cargar. `key` es la ruta de origen.
+    pub fn sound_add(&mut self, bytes: Vec<u8>, key: &str) -> f64 {
+        let data = match decode(bytes) {
+            Ok(d) => Arc::new(d),
+            Err(e) => {
+                println!("WARNING (FMOD): no se pudo cargar {}: {}", key, e);
+                return 0.0
+            },
+        };
+        self.library.insert(key.to_string(), data.clone());
+        let sound = Sound { key: key.to_string(), data, group: 0, max_volume: 1.0, loop_start: 0.0, loop_end: 1.0 };
+        if let Some(i) = self.sounds.iter().position(Option::is_none) {
+            self.sounds[i] = Some(sound);
+            (i + 1) as f64
+        } else {
+            self.sounds.push(Some(sound));
+            self.sounds.len() as f64
+        }
+    }
+
+    pub fn sound_free(&mut self, id: f64) -> f64 {
+        let i = id as i64 - 1;
+        if self.sound(id).is_none() {
+            return 0.0
+        }
+        self.instances.retain(|_, inst| inst.sound as i64 != i);
+        self.sounds[i as usize] = None;
+        1.0
+    }
+
+    /// Duración en milisegundos.
+    pub fn sound_get_length(&self, id: f64) -> f64 {
+        self.sound(id).map(|s| s.data.length() as f64 * 1000.0 / s.data.rate() as f64).unwrap_or(0.0)
+    }
+
+    pub fn sound_set_loop_points(&mut self, id: f64, start: f64, end: f64) -> f64 {
+        match self.sound_mut(id) {
+            Some(s) => {
+                s.loop_start = start.clamp(0.0, 1.0);
+                s.loop_end = end.clamp(0.0, 1.0);
+                1.0
+            },
+            None => 0.0,
+        }
+    }
+
+    pub fn sound_set_max_volume(&mut self, id: f64, volume: f64) -> f64 {
+        match self.sound_mut(id) {
+            Some(s) => {
+                s.max_volume = volume.clamp(0.0, 1.0);
+                1.0
+            },
+            None => 0.0,
+        }
+    }
+
+    pub fn sound_set_group(&mut self, id: f64, group: f64) -> f64 {
+        let group = (group as i64).clamp(0, 4) as usize;
+        match self.sound_mut(id) {
+            Some(s) => {
+                s.group = group;
+                1.0
+            },
+            None => 0.0,
+        }
+    }
+
+    /// FMODSoundPlay / FMODSoundLoop: devuelve el id de la instancia, o 0.
+    pub fn sound_play(&mut self, id: f64, paused: bool, looping: bool) -> f64 {
+        let Some(sound) = self.sound(id) else { return 0.0 };
+        let data = sound.data.clone();
+        let instance = Instance {
+            sound: id as usize - 1,
+            stream: matches!(*data, Data::Ogg { .. }).then(|| OggStream::new(&data)).flatten(),
+            data,
+            pos: 0.0,
+            pitch: 1.0,
+            volume: 1.0,
+            paused,
+            looping,
+        };
+        let handle = self.next_instance;
+        self.next_instance = self.next_instance.wrapping_add(1).max(1);
+        self.instances.insert(handle, instance);
+        handle as f64
+    }
+
+    pub fn instance_stop(&mut self, id: f64) -> f64 {
+        self.instances.remove(&(id as i64 as u32)).is_some() as u8 as f64
+    }
+
+    pub fn instance_is_playing(&self, id: f64) -> f64 {
+        u32::try_from(id as i64).ok().map(|h| self.instances.contains_key(&h)).unwrap_or(false) as u8 as f64
+    }
+
+    pub fn instance_set_paused(&mut self, id: f64, paused: bool) -> f64 {
+        match self.instance_mut(id) {
+            Some(i) => {
+                i.paused = paused;
+                1.0
+            },
+            None => 0.0,
+        }
+    }
+
+    pub fn instance_set_volume(&mut self, id: f64, volume: f64) -> f64 {
+        match self.instance_mut(id) {
+            Some(i) => {
+                i.volume = volume.clamp(0.0, 1.0);
+                1.0
+            },
+            None => 0.0,
+        }
+    }
+
+    pub fn instance_set_pitch(&mut self, id: f64, pitch: f64) -> f64 {
+        match self.instance_mut(id) {
+            Some(i) => {
+                i.pitch = pitch.clamp(0.0, 10.0);
+                1.0
+            },
+            None => 0.0,
+        }
+    }
+
+    /// Posición como fracción de la duración.
+    pub fn instance_get_position(&self, id: f64) -> f64 {
+        u32::try_from(id as i64)
+            .ok()
+            .and_then(|h| self.instances.get(&h))
+            .map(|i| i.pos / i.data.length().max(1) as f64)
+            .unwrap_or(0.0)
+    }
+
+    pub fn instance_set_position(&mut self, id: f64, position: f64) -> f64 {
+        match self.instance_mut(id) {
+            Some(i) => {
+                i.pos = position.clamp(0.0, 1.0) * i.data.length() as f64;
+                1.0
+            },
+            None => 0.0,
+        }
+    }
+
+    pub fn group_set_volume(&mut self, group: f64, volume: f64) -> f64 {
+        let g = (group as i64).clamp(0, 4) as usize;
+        self.groups[g].volume = volume.clamp(0.0, 1.0);
+        1.0
+    }
+
+    pub fn group_set_pitch(&mut self, group: f64, pitch: f64) -> f64 {
+        let g = (group as i64).clamp(0, 4) as usize;
+        self.groups[g].pitch = pitch.clamp(0.0, 10.0);
+        1.0
+    }
+
+    pub fn master_set_volume(&mut self, volume: f64) -> f64 {
+        self.master_volume = volume.clamp(0.0, 1.0);
+        1.0
+    }
+
+    pub fn all_stop(&mut self) -> f64 {
+        self.instances.clear();
+        1.0
+    }
+
+    /// FMODfree: libera todo.
+    pub fn free(&mut self) -> f64 {
+        self.instances.clear();
+        self.sounds.clear();
+        1.0
+    }
+
+    /// Avanza un paso del juego. Siempre recorre las muestras una por una para que la posición resultante
+    /// sea idéntica con y sin mezcla.
+    pub fn step(&mut self, room_speed: u32) {
+        self.sample_acc += RATE as f64 / room_speed.max(1) as f64;
+        let n = self.sample_acc as usize;
+        self.sample_acc -= n as f64;
+
+        let mixing = self.output.is_some();
+        if mixing {
+            self.mix.clear();
+            self.mix.resize(n, [0.0; 2]);
+        }
+
+        let master_pitch = self.groups[0].pitch;
+        let master_volume = self.master_volume * self.groups[0].volume;
+        let mut finished = Vec::new();
+        for (&handle, inst) in self.instances.iter_mut() {
+            if inst.paused {
+                continue
+            }
+            let Some(sound) = self.sounds.get(inst.sound).and_then(Option::as_ref) else {
+                finished.push(handle);
+                continue
+            };
+            let group = self.groups[sound.group];
+            let length = inst.data.length() as f64;
+            let ratio = inst.data.rate() as f64 / RATE as f64 * inst.pitch * group.pitch * master_pitch;
+            let (loop_start, loop_end) = {
+                let (a, b) = (sound.loop_start * length, sound.loop_end * length);
+                if b > a { (a, b) } else { (0.0, length) }
+            };
+            let gain = (sound.max_volume * inst.volume * group.volume * master_volume) as f32;
+
+            for out in 0..n {
+                if !inst.looping && inst.pos >= length {
+                    finished.push(handle);
+                    break
+                }
+                if mixing && gain > 0.0 {
+                    let [l, r] = sample_at(inst, inst.pos);
+                    let m = &mut self.mix[out];
+                    m[0] += l * gain;
+                    m[1] += r * gain;
+                }
+                inst.pos += ratio;
+                if inst.looping && inst.pos >= loop_end {
+                    inst.pos = loop_start + (inst.pos - loop_end) % (loop_end - loop_start);
+                }
+            }
+            // Un sonido sin loop que justo terminó en este paso deja de sonar ahora, no en el siguiente.
+            if !inst.looping && inst.pos >= length && finished.last() != Some(&handle) {
+                finished.push(handle);
+            }
+        }
+        for h in finished {
+            self.instances.remove(&h);
+        }
+
+        if let Some(out) = &self.output {
+            if let Ok(mut q) = out.lock() {
+                q.extend(self.mix.iter().flat_map(|[l, r]| [l.clamp(-1.0, 1.0), r.clamp(-1.0, 1.0)]));
+                let excess = q.len().saturating_sub(MAX_QUEUED_FRAMES * 2);
+                q.drain(..excess);
+            }
+        }
+    }
+}
+
+/// Muestra en la posición `pos` (en cuadros de la fuente), con interpolación lineal.
+fn sample_at(inst: &mut Instance, pos: f64) -> [f32; 2] {
+    let i = pos as u64;
+    let t = (pos - i as f64) as f32;
+    let (a, b) = match &*inst.data {
+        Data::Pcm { frames, .. } => {
+            let a = frames.get(i as usize).copied().unwrap_or([0.0; 2]);
+            let b = frames.get(i as usize + 1).copied().unwrap_or(a);
+            (a, b)
+        },
+        Data::Ogg { .. } => match &mut inst.stream {
+            Some(s) => {
+                let a = s.get(i);
+                (a, s.get(i + 1))
+            },
+            None => ([0.0; 2], [0.0; 2]),
+        },
+    };
+    [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t]
+}
+
+/// Decodificador OGG por instancia. Guarda una ventana de cuadros decodificados; para retroceder (loop,
+/// cambio de posición) vuelve a empezar desde el principio del archivo.
+struct OggStream {
+    bytes: Arc<[u8]>,
+    reader: lewton::inside_ogg::OggStreamReader<Cursor<Arc<[u8]>>>,
+    buf: VecDeque<[f32; 2]>,
+    buf_start: u64,
+    ended: bool,
+}
+
+impl OggStream {
+    fn new(data: &Data) -> Option<Self> {
+        let Data::Ogg { bytes, .. } = data else { return None };
+        let reader = lewton::inside_ogg::OggStreamReader::new(Cursor::new(bytes.clone())).ok()?;
+        Some(Self { bytes: bytes.clone(), reader, buf: VecDeque::new(), buf_start: 0, ended: false })
+    }
+
+    fn rewind(&mut self) {
+        if let Ok(r) = lewton::inside_ogg::OggStreamReader::new(Cursor::new(self.bytes.clone())) {
+            self.reader = r;
+        }
+        self.buf.clear();
+        self.buf_start = 0;
+        self.ended = false;
+    }
+
+    fn get(&mut self, frame: u64) -> [f32; 2] {
+        if frame < self.buf_start {
+            self.rewind();
+        }
+        while frame >= self.buf_start + self.buf.len() as u64 {
+            if self.ended {
+                return [0.0; 2]
+            }
+            // Conservar solo el último cuadro (para interpolar) al avanzar mucho.
+            if self.buf.len() > 8192 {
+                let drop = self.buf.len() - 1;
+                self.buf.drain(..drop);
+                self.buf_start += drop as u64;
+            }
+            let channels = self.reader.ident_hdr.audio_channels as usize;
+            match self.reader.read_dec_packet_itl() {
+                Ok(Some(pcm)) => {
+                    for c in pcm.chunks_exact(channels.max(1)) {
+                        let l = c[0] as f32 / 32768.0;
+                        let r = c.get(1).map(|&x| x as f32 / 32768.0).unwrap_or(l);
+                        self.buf.push_back([l, r]);
+                    }
+                },
+                _ => self.ended = true,
+            }
+        }
+        self.buf[(frame - self.buf_start) as usize]
+    }
+}
+
+fn decode(bytes: Vec<u8>) -> Result<Data, String> {
+    if bytes.starts_with(b"OggS") {
+        let bytes: Arc<[u8]> = bytes.into();
+        let reader = lewton::inside_ogg::OggStreamReader::new(Cursor::new(bytes.clone())).map_err(|e| e.to_string())?;
+        let rate = reader.ident_hdr.audio_sample_rate;
+        let length = ogg_length(&bytes).ok_or("no se encontró la última página OGG")?;
+        Ok(Data::Ogg { rate, bytes, length })
+    } else if bytes.starts_with(b"RIFF") {
+        let mut reader = hound::WavReader::new(Cursor::new(bytes)).map_err(|e| e.to_string())?;
+        let spec = reader.spec();
+        let samples: Vec<f32> = match spec.sample_format {
+            hound::SampleFormat::Float => reader.samples::<f32>().filter_map(Result::ok).collect(),
+            hound::SampleFormat::Int => {
+                let scale = 1.0 / (1u64 << (spec.bits_per_sample - 1)) as f32;
+                reader.samples::<i32>().filter_map(Result::ok).map(|s| s as f32 * scale).collect()
+            },
+        };
+        let channels = spec.channels.max(1) as usize;
+        let frames = samples
+            .chunks_exact(channels)
+            .map(|c| [c[0], c.get(1).copied().unwrap_or(c[0])])
+            .collect();
+        Ok(Data::Pcm { rate: spec.sample_rate, frames })
+    } else {
+        Err("formato no soportado (solo OGG y WAV)".into())
+    }
+}
+
+/// Cantidad de cuadros de un OGG Vorbis: la posición de gránulo de la última página.
+fn ogg_length(bytes: &[u8]) -> Option<u64> {
+    let start = bytes.len().saturating_sub(65536);
+    let tail = &bytes[start..];
+    let p = tail.windows(4).rposition(|w| w == b"OggS")?;
+    let gp = tail.get(p + 6..p + 14)?;
+    Some(u64::from_le_bytes(gp.try_into().ok()?))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Mezcla 3 s de un OGG o WAV real con loop. Uso:
+    /// `FMOD_TEST_FILE=archivo.ogg [FMOD_TEST_OUT=salida.wav] cargo test -p gm8emulator fmod -- --nocapture`
+    #[test]
+    fn mezcla_archivo_real() {
+        let Ok(path) = std::env::var("FMOD_TEST_FILE") else { return };
+        let queue: OutputQueue = Default::default();
+        let mut fmod = Fmod::new();
+        fmod.set_output(Some(queue.clone()));
+        let snd = fmod.sound_add(std::fs::read(&path).unwrap(), &path);
+        assert!(snd > 0.0);
+        let len_ms = fmod.sound_get_length(snd);
+        // loop entre el 10% y el 10% + 1 s, para pasar al menos dos veces por el punto de loop
+        fmod.sound_set_loop_points(snd, 0.1, 0.1 + 1000.0 / len_ms);
+        let inst = fmod.sound_play(snd, false, true);
+        fmod.instance_set_position(inst, 0.1);
+        let mut out = Vec::new();
+        for _ in 0..150 {
+            fmod.step(50);
+            out.extend(queue.lock().unwrap().drain(..));
+        }
+        assert_eq!(out.len(), 3 * RATE as usize * 2);
+        assert_eq!(fmod.instance_is_playing(inst), 1.0);
+        let rms = (out.iter().map(|s| (s * s) as f64).sum::<f64>() / out.len() as f64).sqrt();
+        println!("duración {:.0} ms, rms {:.4}, posición {:.4}", len_ms, rms, fmod.instance_get_position(inst));
+        assert!(rms > 0.001);
+        let pos = fmod.instance_get_position(inst);
+        assert!(pos >= 0.1 && pos < 0.1 + 1000.0 / len_ms, "posición fuera del loop: {}", pos);
+        if let Ok(o) = std::env::var("FMOD_TEST_OUT") {
+            let spec = hound::WavSpec { channels: 2, sample_rate: RATE, bits_per_sample: 16, sample_format: hound::SampleFormat::Int };
+            let mut w = hound::WavWriter::create(o, spec).unwrap();
+            for s in out {
+                w.write_sample((s * 32767.0) as i16).unwrap();
+            }
+            w.finalize().unwrap();
+        }
+    }
+
+    #[test]
+    fn instancia_termina_a_tiempo() {
+        // 1 s de silencio a 22050 Hz, pitch 2: debe durar 0,5 s = 25 pasos a 50 fps.
+        let mut wav = Vec::new();
+        {
+            let spec = hound::WavSpec { channels: 1, sample_rate: 22050, bits_per_sample: 16, sample_format: hound::SampleFormat::Int };
+            let mut w = hound::WavWriter::new(std::io::Cursor::new(&mut wav), spec).unwrap();
+            for _ in 0..22050 {
+                w.write_sample(0i16).unwrap();
+            }
+            w.finalize().unwrap();
+        }
+        let mut fmod = Fmod::new();
+        let snd = fmod.sound_add(wav, "prueba");
+        assert_eq!(fmod.sound_get_length(snd), 1000.0);
+        let inst = fmod.sound_play(snd, false, false);
+        fmod.instance_set_pitch(inst, 2.0);
+        for _ in 0..24 {
+            fmod.step(50);
+        }
+        assert_eq!(fmod.instance_is_playing(inst), 1.0);
+        fmod.step(50);
+        fmod.step(50);
+        assert_eq!(fmod.instance_is_playing(inst), 0.0);
+    }
+
+    #[test]
+    fn savestate_vuelve_atras() {
+        let mut wav = Vec::new();
+        {
+            let spec = hound::WavSpec { channels: 1, sample_rate: 44100, bits_per_sample: 16, sample_format: hound::SampleFormat::Int };
+            let mut w = hound::WavWriter::new(std::io::Cursor::new(&mut wav), spec).unwrap();
+            for i in 0..44100 {
+                w.write_sample((i % 1000) as i16).unwrap();
+            }
+            w.finalize().unwrap();
+        }
+        let mut fmod = Fmod::new();
+        let snd = fmod.sound_add(wav, "prueba");
+        let inst = fmod.sound_play(snd, false, false);
+        for _ in 0..10 {
+            fmod.step(50);
+        }
+        let state = fmod.save_state();
+        let pos = fmod.instance_get_position(inst);
+        for _ in 0..45 {
+            fmod.step(50);
+        }
+        assert_eq!(fmod.instance_is_playing(inst), 0.0);
+        fmod.load_state(state);
+        assert_eq!(fmod.instance_is_playing(inst), 1.0);
+        assert_eq!(fmod.instance_get_position(inst), pos);
+        // Un sonido nuevo no reutiliza el handle de la instancia restaurada.
+        assert_ne!(fmod.sound_play(snd, false, false), inst);
+    }
+}
