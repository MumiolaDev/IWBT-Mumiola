diff --git a/gm8emulator/src/game/external/emulated.rs b/gm8emulator/src/game/external/emulated.rs
new file mode 100644
index 0000000..f9d8912
--- /dev/null
+++ b/gm8emulator/src/game/external/emulated.rs
@@ -0,0 +1,264 @@
+//! Reimplementaciones en Rust de DLL comunes en juegos de GameMaker, para plataformas donde no se pueden
+//! cargar DLL de Windows (Linux sin Wine, Android).
+//!
+//! - gm82core / gm82dx8 / gm82joy (extensiones de Game Maker 8.2, https://github.com/GM82Project):
+//!   solo las funciones que hacen falta para arrancar y las de matemática; lo que depende de Direct3D o de la
+//!   ventana de Windows devuelve un valor neutro.
+//! - SDL2 (lo carga gm82joy): solo SDL_GetError.
+//! - GMFMODSimple: reimplementado en `fmod.rs`, con el estado guardado en `Game::fmod`.
+//! - fmodex: solo se usa para comprobar que existe; todo devuelve 0.
+//!
+//! Las funciones que no están en la tabla de una DLL conocida devuelven 0 o "" según su tipo de retorno.
+
+use super::dll::{ExternalSignature, ValueType};
+use crate::{
+    game::Game,
+    gml::{self, Function, Value},
+};
+
+/// Nombre de archivo de la DLL en minúsculas, aceptando separadores de Windows y de Unix.
+fn dll_basename(dll: &str) -> String {
+    dll.rsplit(|c| c == '\\' || c == '/').next().unwrap_or(dll).to_ascii_lowercase()
+}
+
+fn arg(args: &[Value], i: usize) -> f64 {
+    args.get(i).cloned().map(f64::from).unwrap_or(0.0)
+}
+
+fn dsin(deg: f64) -> f64 {
+    (deg / 180.0 * std::f64::consts::PI).sin()
+}
+
+fn dcos(deg: f64) -> f64 {
+    (deg / 180.0 * std::f64::consts::PI).cos()
+}
+
+/// Microsegundos según el reloj del juego (falseado y determinista en grabación y replay).
+fn micros(game: &Game) -> f64 {
+    (game.clock.as_nanos() / 1000) as f64
+}
+
+// ---- gm82core ----
+
+fn ret_820(_: &[Value]) -> gml::Result<Value> {
+    Ok(820.into())
+}
+
+fn ret_0(_: &[Value]) -> gml::Result<Value> {
+    Ok(0.into())
+}
+
+fn ret_1(_: &[Value]) -> gml::Result<Value> {
+    Ok(1.into())
+}
+
+fn ret_empty(_: &[Value]) -> gml::Result<Value> {
+    Ok("".into())
+}
+
+fn hrt_now(game: &Game, _: &[Value]) -> gml::Result<Value> {
+    Ok(micros(game).into())
+}
+
+fn approach(args: &[Value]) -> gml::Result<Value> {
+    let (val, go, step) = (arg(args, 0), arg(args, 1), arg(args, 2));
+    Ok(if val < go { go.min(val + step) } else { go.max(val - step) }.into())
+}
+
+fn gm82_dsin(args: &[Value]) -> gml::Result<Value> {
+    Ok(dsin(arg(args, 0)).into())
+}
+
+fn gm82_dcos(args: &[Value]) -> gml::Result<Value> {
+    Ok(dcos(arg(args, 0)).into())
+}
+
+fn in_range(args: &[Value]) -> gml::Result<Value> {
+    let (val, min, max) = (arg(args, 0), arg(args, 1), arg(args, 2));
+    Ok(Value::from(val >= min && val <= max))
+}
+
+fn pivot_pos_x(args: &[Value]) -> gml::Result<Value> {
+    let (px, py, dir) = (arg(args, 0), arg(args, 1), arg(args, 2));
+    Ok((px * dcos(dir) + py * dcos(dir - 90.0)).into())
+}
+
+fn pivot_pos_y(args: &[Value]) -> gml::Result<Value> {
+    let (px, py, dir) = (arg(args, 0), arg(args, 1), arg(args, 2));
+    Ok((-px * dsin(dir) - py * dsin(dir - 90.0)).into())
+}
+
+fn get_windows_version(_: &[Value]) -> gml::Result<Value> {
+    Ok(10.into())
+}
+
+/// LCID de Windows a partir del idioma del sistema (variable LANG en Unix).
+fn io_get_language(_: &[Value]) -> gml::Result<Value> {
+    let lang = std::env::var("OPENGMK_LANG").or_else(|_| std::env::var("LANG")).unwrap_or_default();
+    let lcid = match lang.get(..2) {
+        Some("es") => 0x0C0A,
+        Some("ja") => 0x0411,
+        Some("pt") => 0x0416,
+        Some("fr") => 0x040C,
+        Some("de") => 0x0407,
+        _ => 0x0409,
+    };
+    Ok(lcid.into())
+}
+
+/// Color de acento de la barra de título (azul por defecto de Windows 10, en BGR).
+fn get_window_col(_: &[Value]) -> gml::Result<Value> {
+    Ok(0xD77800.into())
+}
+
+// ---- gm82dx8 ----
+
+fn dx8_max_texture_size(game: &Game, _: &[Value]) -> gml::Result<Value> {
+    Ok(f64::from(game.renderer.max_texture_size()).into())
+}
+
+/// VRAM libre en MB. No hay forma portátil de saberlo; se informa una cantidad holgada.
+fn dx8_video_memory(_: &[Value]) -> gml::Result<Value> {
+    Ok(1024.into())
+}
+
+fn dx8_transformvertex(args: &[Value]) -> gml::Result<Value> {
+    // Sin matriz de mundo: se devuelve el vértice tal cual.
+    Ok(arg(args, 0).into())
+}
+
+// ---- GMFMODSimple ----
+
+fn fmod_sound_add(game: &mut Game, args: &[Value]) -> gml::Result<Value> {
+    let name: gml::String = args.get(0).cloned().unwrap_or_default().into();
+    let name = game.decode_str(name.as_ref()).into_owned();
+    let path = gml::file::to_path(&name);
+    match std::fs::read(path.as_ref()) {
+        Ok(bytes) => Ok(game.fmod.sound_add(bytes, &path).into()),
+        Err(_) => Ok(0.into()),
+    }
+}
+
+macro_rules! fmod_fn {
+    ($name: ident, |$f: ident, $a: ident| $body: expr) => {
+        fn $name(game: &mut Game, args: &[Value]) -> gml::Result<Value> {
+            let $f = &mut game.fmod;
+            let $a = |i| arg(args, i);
+            Ok(Value::from($body))
+        }
+    };
+}
+
+fmod_fn!(fmod_sound_free, |f, a| f.sound_free(a(0)));
+fmod_fn!(fmod_sound_get_length, |f, a| f.sound_get_length(a(0)));
+fmod_fn!(fmod_sound_set_loop_points, |f, a| f.sound_set_loop_points(a(0), a(1), a(2)));
+fmod_fn!(fmod_sound_set_max_volume, |f, a| f.sound_set_max_volume(a(0), a(1)));
+fmod_fn!(fmod_sound_set_group, |f, a| f.sound_set_group(a(0), a(1)));
+fmod_fn!(fmod_sound_play, |f, a| f.sound_play(a(0), a(1) >= 0.5, false));
+fmod_fn!(fmod_sound_loop, |f, a| f.sound_play(a(0), a(1) >= 0.5, true));
+fmod_fn!(fmod_instance_stop, |f, a| f.instance_stop(a(0)));
+fmod_fn!(fmod_instance_is_playing, |f, a| f.instance_is_playing(a(0)));
+fmod_fn!(fmod_instance_set_paused, |f, a| f.instance_set_paused(a(0), a(1) >= 0.5));
+fmod_fn!(fmod_instance_set_volume, |f, a| f.instance_set_volume(a(0), a(1)));
+fmod_fn!(fmod_instance_set_pitch, |f, a| f.instance_set_pitch(a(0), a(1)));
+fmod_fn!(fmod_instance_get_position, |f, a| f.instance_get_position(a(0)));
+fmod_fn!(fmod_instance_set_position, |f, a| f.instance_set_position(a(0), a(1)));
+fmod_fn!(fmod_group_set_volume, |f, a| f.group_set_volume(a(0), a(1)));
+fmod_fn!(fmod_group_set_pitch, |f, a| f.group_set_pitch(a(0), a(1)));
+fmod_fn!(fmod_master_set_volume, |f, a| f.master_set_volume(a(0)));
+fmod_fn!(fmod_all_stop, |f, _a| f.all_stop());
+fmod_fn!(fmod_free, |f, _a| f.free());
+
+fn lookup(dll: &str, symbol: &str) -> Option<Function> {
+    Some(match (dll, symbol) {
+        ("gm82core.dll", "__gm82core_dllcheck") => Function::Pure(ret_820),
+        // Siempre "primera vez": game_restart no pierde memoria en el emulador.
+        ("gm82core.dll", "__gm82core_checkstart") => Function::Pure(ret_1),
+        ("gm82core.dll", "__hrt_init") => Function::Pure(ret_1),
+        ("gm82core.dll", "hrt_now") => Function::Volatile(hrt_now),
+        ("gm82core.dll", "get_foreground_window") => Function::Pure(ret_1),
+        ("gm82core.dll", "approach") => Function::Pure(approach),
+        ("gm82core.dll", "dsin") => Function::Pure(gm82_dsin),
+        ("gm82core.dll", "dcos") => Function::Pure(gm82_dcos),
+        ("gm82core.dll", "in_range") => Function::Pure(in_range),
+        ("gm82core.dll", "pivot_pos_x") => Function::Pure(pivot_pos_x),
+        ("gm82core.dll", "pivot_pos_y") => Function::Pure(pivot_pos_y),
+        ("gm82core.dll", "get_windows_version") => Function::Pure(get_windows_version),
+        ("gm82core.dll", "io_get_language") => Function::Volatile(|_, a| io_get_language(a)),
+        ("gm82core.dll", "get_window_col") => Function::Pure(get_window_col),
+
+        ("gm82dx8.dll", "__gm82dx8_dllcheck") => Function::Pure(ret_820),
+        // 0 = no había arrancado, así que la inicialización sigue.
+        ("gm82dx8.dll", "__gm82dx8_checkstart") => Function::Pure(ret_0),
+        // 0 = Windows XP: desactiva el vsync propio de la extensión; el emulador marca el ritmo.
+        ("gm82dx8.dll", "__gm82dx8_not_xp") => Function::Pure(ret_0),
+        ("gm82dx8.dll", "__gm82dx8_waitvblank") => Function::Pure(ret_1),
+        ("gm82dx8.dll", "__gm82dx8_time_now") => Function::Volatile(hrt_now),
+        ("gm82dx8.dll", "__gm82dx8_transformvertex") => Function::Pure(dx8_transformvertex),
+        ("gm82dx8.dll", "__gm82dx8_getmaxwidth") => Function::Volatile(dx8_max_texture_size),
+        ("gm82dx8.dll", "__gm82dx8_getmaxheight") => Function::Volatile(dx8_max_texture_size),
+        ("gm82dx8.dll", "__gm82dx8_getvideomem") => Function::Pure(dx8_video_memory),
+
+        ("sdl2.dll", "SDL_GetError") => Function::Pure(ret_empty),
+
+        ("gmfmodsimple.dll", "FMODinit") => Function::Pure(ret_1),
+        ("gmfmodsimple.dll", "FMODUpdate") => Function::Pure(ret_1),
+        ("gmfmodsimple.dll", "FMODfree") => Function::Engine(fmod_free),
+        ("gmfmodsimple.dll", "FMODAllStop") => Function::Engine(fmod_all_stop),
+        ("gmfmodsimple.dll", "FMODSoundAdd") => Function::Engine(fmod_sound_add),
+        ("gmfmodsimple.dll", "FMODSoundFree") => Function::Engine(fmod_sound_free),
+        ("gmfmodsimple.dll", "FMODSoundGetLength") => Function::Engine(fmod_sound_get_length),
+        ("gmfmodsimple.dll", "FMODSoundSetLoopPoints") => Function::Engine(fmod_sound_set_loop_points),
+        ("gmfmodsimple.dll", "FMODSoundSetMaxVolume") => Function::Engine(fmod_sound_set_max_volume),
+        ("gmfmodsimple.dll", "FMODSoundSetGroup") => Function::Engine(fmod_sound_set_group),
+        ("gmfmodsimple.dll", "FMODSoundPlay") => Function::Engine(fmod_sound_play),
+        ("gmfmodsimple.dll", "FMODSoundLoop") => Function::Engine(fmod_sound_loop),
+        ("gmfmodsimple.dll", "FMODInstanceStop") => Function::Engine(fmod_instance_stop),
+        ("gmfmodsimple.dll", "FMODInstanceIsPlaying") => Function::Engine(fmod_instance_is_playing),
+        ("gmfmodsimple.dll", "FMODInstanceSetPaused") => Function::Engine(fmod_instance_set_paused),
+        ("gmfmodsimple.dll", "FMODInstanceSetVolume") => Function::Engine(fmod_instance_set_volume),
+        ("gmfmodsimple.dll", "FMODInstanceSetPitch") => Function::Engine(fmod_instance_set_pitch),
+        ("gmfmodsimple.dll", "FMODInstanceGetPosition") => Function::Engine(fmod_instance_get_position),
+        ("gmfmodsimple.dll", "FMODInstanceSetPosition") => Function::Engine(fmod_instance_set_position),
+        ("gmfmodsimple.dll", "FMODGroupSetVolume") => Function::Engine(fmod_group_set_volume),
+        ("gmfmodsimple.dll", "FMODGroupSetPitch") => Function::Engine(fmod_group_set_pitch),
+        ("gmfmodsimple.dll", "FMODMasterSetVolume") => Function::Engine(fmod_master_set_volume),
+
+        _ => return None,
+    })
+}
+
+/// DLL que se emulan por completo: cualquier símbolo suyo se resuelve aquí, aunque no esté en la tabla.
+const KNOWN_DLLS: &[&str] = &["gm82core.dll", "gm82dx8.dll", "gm82joy.dll", "sdl2.dll", "gmfmodsimple.dll", "fmodex.dll"];
+
+pub enum Emulation {
+    Function(Function),
+    Missing(Value),
+}
+
+/// Avisa por stdout la primera vez que el juego llama una función emulada que falta.
+pub fn report_missing(signature: &ExternalSignature) {
+    use std::{collections::HashSet, sync::Mutex};
+    static SEEN: Mutex<Option<HashSet<String>>> = Mutex::new(None);
+    let name = format!("{}!{}", dll_basename(&signature.dll), signature.symbol);
+    if let Ok(mut seen) = SEEN.lock() {
+        if seen.get_or_insert_with(HashSet::new).insert(name.clone()) {
+            println!("DLL emulada: se llamó {}, que no está implementada; devuelve un valor vacío", name);
+        }
+    }
+}
+
+/// Busca una reimplementación para la firma. `None` si la DLL no es conocida.
+pub fn find(signature: &ExternalSignature) -> Option<Emulation> {
+    let dll = dll_basename(&signature.dll);
+    if !KNOWN_DLLS.contains(&dll.as_str()) {
+        return None
+    }
+    Some(match lookup(&dll, &signature.symbol) {
+        Some(f) => Emulation::Function(f),
+        None => Emulation::Missing(match signature.type_return {
+            ValueType::Real => 0.into(),
+            ValueType::Str => "".into(),
+        }),
+    })
+}
